datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Subject {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  teachers     Teacher[]   @relation("TeacherSubjects")
  classes      ClassData[]
  fixedClasses FixedClass[] @relation("SubjectFixedClasses")
}

model Teacher {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  subjects     Subject[]   @relation("TeacherSubjects")
  classes      ClassData[]
  fixedClasses FixedClass[] @relation("TeacherFixedClasses")
}

model ClassData {
  id         Int      @id @default(autoincrement())
  dayIndex   Int
  timeIndex  Int
  subjectId  Int
  teacherId  Int
  date       String
  isFixed    Boolean  @default(false)
  className  String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
}

model FixedClass {
  id         Int      @id @default(autoincrement())
  dayIndex   Int
  timeIndex  Int
  subjectId  Int
  teacherId  Int
  className  String
  subject    Subject  @relation("SubjectFixedClasses", fields: [subjectId], references: [id])
  teacher    Teacher  @relation("TeacherFixedClasses", fields: [teacherId], references: [id])
}