generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Ou o banco de dados que você está usando (ex: postgresql, mysql)
  url      = "file:./dev.db" // Substitua pela URL do seu banco de dados
}

model ClassData {
  id         Int      @id @default(autoincrement())
  dayIndex   Int
  timeIndex  Int
  subjectId  Int
  teacherId  Int
  date       String
  isFixed    Boolean  @default(false)
  className  String
}

model FixedClass {
  id         Int      @id @default(autoincrement())
  dayIndex   Int
  timeIndex  Int
  subjectId  Int
  teacherId  Int
  className  String
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String
}

model Teacher {
  id       Int      @id @default(autoincrement())
  name     String
  subjects Subject[]
}